{
  "manifest_version": 3,
  "name": "肥鱼抓兔-改",
  "version": "0.2.17",
  "description": "网页图片抓取：解析、尺寸筛选、预览选择、批量/打包下载、AI 广域检索（肥鱼抓兔-改）",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "*://*.imgbb.com/*",
    "*://ibb.co/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_title": "抓取本页图片",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
